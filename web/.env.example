# Server-side only (not exposed to browser)
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
VNSTOCK_API_URL=http://<lightsail-ip>:8000

# Public: exposed to browser for SSE streaming (VITE_ prefix = client-accessible)
VITE_VNSTOCK_API_URL=http://<lightsail-ip>:8000

# OpenRouter — for chat interface (server-side only, 16-provider failover)
OPENROUTER_API_KEY=sk-or-v1_your_key_here
